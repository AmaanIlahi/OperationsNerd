# Copy this file to .env and fill in your real key.
# .env is gitignored and must never be committed.

GEMINI_API_KEY=your-api-key-here

# --- Agentic CRM (see documentation/deployment.md) ---
# Leave APP_ENV unset for local development. Set APP_ENV=production on a server:
# it then refuses to start without SESSION_SECRET and the selected provider's API key.
# APP_ENV=production
# SESSION_SECRET=at-least-32-random-characters
# LLM_PROVIDER=gemini                          # gemini (default) | anthropic | stub
# GEMINI_MODEL=gemini-3.8-flash                # default; exact id from the SDK's model list
# ANTHROPIC_API_KEY=your-anthropic-key         # only when LLM_PROVIDER=anthropic
# ANTHROPIC_MODEL=claude-sonnet-5-5
# SIGNUP_INVITE_CODE=choose-an-invite-code     # signup is closed without it
# DATABASE_PATH=/data/operations_nerd.db       # default: operations_nerd/db/operations_nerd.db (PythonAnywhere: /home/<username>/opsnerd_data/operations_nerd.db)
# CHAT_DAILY_LIMIT=50
# TRUSTED_PROXIES=*                            # only behind the platform's proxy
