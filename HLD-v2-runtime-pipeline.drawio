<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="Runtime Pipeline" id="pipeline-main">
    <mxGraphModel dx="2400" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="100" value="Operations Nerd — Event Runtime Pipeline (v2)" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="2120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="101" value="Per inbound event. 10 stages. Idempotent ingest → outbox + saga execution → audit + live feedback. Every stage emits an Event row." style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=2;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="55" width="2120" height="25" as="geometry" />
        </mxCell>

        <!-- =================== STAGE LANES (top half = LLM/reasoning, bottom half = I/O/reliability) =================== -->

        <mxCell id="200" value="Reasoning Lanes (LLM calls + state machine)" style="swimlane;startSize=30;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontStyle=2;rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="2120" height="280" as="geometry" />
        </mxCell>

        <mxCell id="210" value="I/O &amp; Reliability Lanes (idempotency, persistence, side effects, audit)" style="swimlane;startSize=30;fillColor=#ffffff;strokeColor=#82b366;dashed=1;fontStyle=2;rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="400" width="2120" height="280" as="geometry" />
        </mxCell>

        <!-- =================== STAGE BOXES (10 stages) =================== -->

        <!-- Stage 1: Ingest -->
        <mxCell id="301" value="1. Ingest&#xa;&#xa;Webhook / polling / CSV&#xa;arrives.&#xa;Tenant resolved.&#xa;Idempotency key =&#xa;(tenant, source, source_event_id)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;" vertex="1" parent="1">
          <mxGeometry x="60" y="200" width="200" height="180" as="geometry" />
        </mxCell>

        <!-- Stage 2: Validity Gate -->
        <mxCell id="302" value="2. Validity Gate&#xa;&#xa;Confirm input is a legitimate&#xa;operational event (not spam,&#xa;not malformed).&#xa;LLM-as-judge + rule prefilter.&#xa;Reject → drop." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=center;" vertex="1" parent="1">
          <mxGeometry x="280" y="200" width="200" height="180" as="geometry" />
        </mxCell>

        <!-- Stage 3: Ontology Conversion -->
        <mxCell id="303" value="3. Ontology Conversion&#xa;&#xa;Convert raw input to&#xa;upper-core entities:&#xa;Party / Engagement /&#xa;Agreement / Transaction /&#xa;Obligation / Event.&#xa;JSON-Schema validated." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;" vertex="1" parent="1">
          <mxGeometry x="500" y="200" width="200" height="180" as="geometry" />
        </mxCell>

        <!-- Stage 4: Context Extraction -->
        <mxCell id="304" value="4. Context Extraction&#xa;&#xa;Pull supporting data:&#xa;existing Party record,&#xa;prior Engagements,&#xa;related Transactions,&#xa;calendar, payment status.&#xa;Read-only Temporal activity." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;" vertex="1" parent="1">
          <mxGeometry x="720" y="200" width="200" height="180" as="geometry" />
        </mxCell>

        <!-- Stage 5: Function Classification -->
        <mxCell id="305" value="5. Function Classification&#xa;&#xa;Route to one of four&#xa;functions: relationship /&#xa;sales / outreach / accounting.&#xa;Route to matching&#xa;vertical-adapter logic.&#xa;Constrained LLM + rule fallback." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;" vertex="1" parent="1">
          <mxGeometry x="940" y="200" width="200" height="180" as="geometry" />
        </mxCell>

        <!-- Stage 6: Compliance & Safety -->
        <mxCell id="306" value="6. Compliance &amp; Safety&#xa;&#xa;Pluggable policy engine:&#xa;- Rule (OPA/Rego, PII regex)&#xa;- LLM-as-judge&#xa;- HITL escalation&#xa;All decisions logged to Audit.&#xa;Pass / Flag / Block." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;" vertex="1" parent="1">
          <mxGeometry x="1160" y="200" width="200" height="180" as="geometry" />
        </mxCell>

        <!-- Stage 7: Action Drafting -->
        <mxCell id="307" value="7. Action Drafting&#xa;&#xa;Generate typed action object:&#xa;SendEmail / PostInvoice /&#xa;CreateCalendarEntry /&#xa;LogTransaction / SetObligation.&#xa;Pure object — never executed.&#xa;Classified auto/approve/block." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;" vertex="1" parent="1">
          <mxGeometry x="1380" y="200" width="200" height="180" as="geometry" />
        </mxCell>

        <!-- Stage 8: HITL Gate (decision) -->
        <mxCell id="308" value="8. HITL Gate&#xa;(approval queue)&#xa;&#xa;If action = requires_approval:&#xa;post to queue.&#xa;Owner: approve / edit / reject /&#xa;promote-to-policy.&#xa;If auto: proceed.&#xa;If block: escalate, never exec." style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=center;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1600" y="180" width="220" height="220" as="geometry" />
        </mxCell>

        <!-- Stage 9: Outbox + Saga -->
        <mxCell id="309" value="9. Action Execution&#xa;(outbox + saga)&#xa;&#xa;Outbox row written in same tx&#xa;as state change.&#xa;Drainer dispatches to adapter.&#xa;Idempotency key:&#xa;(agent_run_id, step_id,&#xa;tool_name, business_scope).&#xa;Compensation on failure." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=center;" vertex="1" parent="1">
          <mxGeometry x="1840" y="200" width="200" height="180" as="geometry" />
        </mxCell>

        <!-- =================== I/O LANE (top half is reasoning, bottom is reliability) =================== -->

        <!-- Persistent state across stages (Postgres write) -->
        <mxCell id="401" value="State (Postgres, RLS-isolated)&#xa;- parties, engagements, transactions,&#xa;obligations, events (append-only)&#xa;- outbox, sagas, approvals, audit_log" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="60" y="450" width="600" height="100" as="geometry" />
        </mxCell>

        <!-- Durable execution substrate (Temporal + LangGraph) -->
        <mxCell id="402" value="Durable execution substrate&#xa;- Temporal Workflow (outer): retries, compensations, multi-day waits&#xa;- LangGraph StateGraph (inner): conditional routing, checkpoint per node" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="700" y="450" width="500" height="100" as="geometry" />
        </mxCell>

        <!-- LLM provider (shared) -->
        <mxCell id="403" value="LLM Provider&#xa;(runtime + judge + drafter)&#xa;Same model, separate prompts &amp; logs" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1240" y="450" width="280" height="100" as="geometry" />
        </mxCell>

        <!-- Adapter connectors (external) -->
        <mxCell id="404" value="Adapter Connectors&#xa;(Gmail / SMS / Stripe / Calendar / QB)&#xa;Token from Vault. Idempotent." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1560" y="450" width="280" height="100" as="geometry" />
        </mxCell>

        <!-- Owner console + approval queue -->
        <mxCell id="405" value="Owner Console (Web)&#xa;- Approval Queue (live, SSE)&#xa;- Override / approve / edit / reject&#xa;- Promote-to-policy (close the loop)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1880" y="450" width="280" height="100" as="geometry" />
        </mxCell>

        <!-- =================== STAGE 10 SPLIT (bottom row) =================== -->

        <mxCell id="500" value="10a. Audit Log (XES-extended Event row, append-only, per stage) — drives discovery, compliance audit, drift monitor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="60" y="580" width="1040" height="50" as="geometry" />
        </mxCell>
        <mxCell id="501" value="10b. Live Feedback (SSE stream to Owner Console, per event_id, stage-by-stage progress)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1120" y="580" width="1040" height="50" as="geometry" />
        </mxCell>

        <!-- =================== EDGES (the 10-stage flow) =================== -->

        <mxCell id="600" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" parent="1" source="301" target="302">
