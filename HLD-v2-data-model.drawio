<mxfile host="drawio" version="26.0.0">
  <diagram name="Data Model" id="datamodel-main">
    <mxGraphModel dx="2400" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="100" value="Operations Nerd — Data Model + Multi-Tenancy (v2)" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="2120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="101" value="Postgres shared schema. Every tenant-scoped table has tenant_id (UUID) + RLS policy + app.current_tenant GUC. Outbox + saga in same DB. Snapshots in object store." style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=2;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="55" width="2120" height="25" as="geometry" />
        </mxCell>

        <!-- =================== UPPER-CORE ONTOLOGY (top) =================== -->

        <mxCell id="200" value="UPPER-CORE ONTOLOGY (universal, 8 entities, two-layer pattern à la O-CREAM-v2)" style="swimlane;startSize=30;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="2120" height="320" as="geometry" />
        </mxCell>

        <mxCell id="201" value="parties&#xa;&#xa;PK: id (UUID)&#xa;tenant_id UUID NOT NULL&#xa;kind TEXT (Party)&#xa;lower_core_subtype TEXT&#xa;attrs JSONB&#xa;created_at, updated_at&#xa;RLS: tenant_id = app.current_tenant" style="shape=note;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="150" width="240" height="140" as="geometry" />
        </mxCell>

        <mxCell id="202" value="party_relationships&#xa;&#xa;PK: id&#xa;tenant_id&#xa;from_party_id → parties&#xa;to_party_id → parties&#xa;kind TEXT (referred_by, household, employer)&#xa;valid_from, valid_to&#xa;RLS" style="shape=note;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="340" y="150" width="240" height="140" as="geometry" />
        </mxCell>

        <mxCell id="203" value="engagements&#xa;&#xa;PK: id&#xa;tenant_id&#xa;party_id → parties&#xa;kind TEXT (Call, Email, Visit, FormSubmit)&#xa;occurred_at TIMESTAMPTZ&#xa;evidence JSONB&#xa;RLS" style="shape=note;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="600" y="150" width="240" height="140" as="geometry" />
        </mxCell>

        <mxCell id="204" value="agreements&#xa;&#xa;PK: id&#xa;tenant_id&#xa;primary_party_id → parties&#xa;kind TEXT (Listing, TreatmentPlan, Retainer)&#xa;effective_from, effective_to&#xa;attrs JSONB&#xa;RLS" style="shape=note;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="860" y="150" width="240" height="140" as="geometry" />
        </mxCell>

        <mxCell id="205" value="transactions&#xa;&#xa;PK: id&#xa;tenant_id&#xa;agreement_id → agreements&#xa;kind TEXT (Invoice, Payment, Refund)&#xa;amount_cents BIGINT&#xa;currency CHAR(3)&#xa;occurred_at&#xa;attrs JSONB&#xa;RLS" style="shape=note;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1120" y="150" width="240" height="140" as="geometry" />
        </mxCell>

        <mxCell id="206" value="transaction_lines&#xa;&#xa;PK: id&#xa;tenant_id&#xa;transaction_id → transactions&#xa;sku, qty, unit_amount_cents&#xa;attrs JSONB&#xa;RLS" style="shape=note;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1380" y="150" width="240" height="140" as="geometry" />
        </mxCell>

        <mxCell id="207" value="obligations&#xa;&#xa;PK: id&#xa;tenant_id&#xa;party_id → parties&#xa;kind TEXT (FollowUp, PreAuth, Recall)&#xa;due_at TIMESTAMPTZ&#xa;status TEXT (open, done, cancelled)&#xa;attrs JSONB&#xa;RLS" style="shape=note;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1640" y="150" width="240" height="140" as="geometry" />
        </mxCell>

        <mxCell id="208" value="events (append-only log)&#xa;&#xa;PK: id&#xa;tenant_id&#xa;kind TEXT (InboundEvent, Action, StateChange)&#xa;occurred_at, stage&#xa;input_hash, decision&#xa;evidence JSONB&#xa;prev_event_id (linked list)&#xa;RLS — no UPDATE/DELETE" style="shape=note;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1900" y="150" width="240" height="140" as="geometry" />
        </mxCell>

        <!-- Edges showing relationships in the upper core -->
        <mxCell id="210" value="1..*" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERmany;startArrow=ERone;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;fontSize=10;strokeColor=#82b366;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="201" target="202">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="211" value="0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERmany;startArrow=ERone;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=10;strokeColor=#82b366;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="201" target="203">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="212" value="1..*" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERmany;startArrow=ERone;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;fontSize=10;strokeColor=#82b366;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="201" target="204">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="213" value="1..*" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERmany;startArrow=ERone;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=10;strokeColor=#82b366;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="204" target="205">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="214" value="1..*" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERmany;startArrow=ERone;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=10;strokeColor=#82b366;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="205" target="206">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="215" value="0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERmany;startArrow=ERone;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=10;strokeColor=#82b366;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="201" target="207">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="40" y="255" />
              <mxPoint x="40" y="220" />
              <mxPoint x="1620" y="220" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="216" value="*" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERmany;startArrow=ERone;exitX=0;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;fontSize=10;strokeColor=#82b366;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="201" target="208">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="20" y="290" />
              <mxPoint x="20" y="240" />
              <mxPoint x="1880" y="240" />
