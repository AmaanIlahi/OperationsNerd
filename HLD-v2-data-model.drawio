          </mxGeometry>
        </mxCell>

        <!-- RLS banner (below upper core) -->
        <mxCell id="290" value="Every table above has:  (a) tenant_id UUID NOT NULL column  (b) ALTER TABLE ... ENABLE ROW LEVEL SECURITY  (c) FORCE ROW LEVEL SECURITY  (d) CREATE POLICY tenant_isolation ON &lt;table&gt; FOR ALL TO app_user USING (tenant_id = current_setting('app.current_tenant')::uuid)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="300" width="2060" height="50" as="geometry" />
        </mxCell>

        <!-- =================== RUNTIME / SIDEC-EFFECT TABLES (middle) =================== -->

        <mxCell id="300" value="RUNTIME + SIDE-EFFECT TABLES (outbox, saga, approvals, audit, snapshots)" style="swimlane;startSize=30;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="440" width="2120" height="240" as="geometry" />
        </mxCell>

        <mxCell id="301" value="outbox&#xa;&#xa;PK: id&#xa;tenant_id&#xa;four_tuple_key TEXT UNIQUE&#xa;(agent_run_id, step_id, tool_name, business_scope)&#xa;payload JSONB&#xa;status TEXT (pending, sent, failed, dead)&#xa;attempts INT&#xa;last_error TEXT&#xa;next_attempt_at TIMESTAMPTZ&#xa;RLS" style="shape=note;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="490" width="280" height="160" as="geometry" />
        </mxCell>

        <mxCell id="302" value="sagas&#xa;&#xa;PK: id&#xa;tenant_id&#xa;kind TEXT (e.g. 'send_email_followup')&#xa;state TEXT (active, completed, compensating, failed)&#xa;forward JSONB (sequence of local txs)&#xa;compensation JSONB (sequence of undo txs)&#xa;started_at, completed_at&#xa;RLS" style="shape=note;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="380" y="490" width="280" height="160" as="geometry" />
        </mxCell>

        <mxCell id="303" value="approvals&#xa;&#xa;PK: id&#xa;tenant_id&#xa;event_id → events&#xa;action JSONB (typed action object)&#xa;evidence JSONB (input hash, retrieval, rule decisions)&#xa;decision TEXT (pending, approved, edited, rejected, promoted_to_policy)&#xa;decided_by USER_ID&#xa;decided_at TIMESTAMPTZ&#xa;RLS" style="shape=note;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="680" y="490" width="280" height="160" as="geometry" />
        </mxCell>

        <mxCell id="304" value="audit_log&#xa;&#xa;PK: id&#xa;tenant_id&#xa;ts TIMESTAMPTZ&#xa;actor (user_id | 'system' | 'agent')&#xa;action TEXT&#xa;target (table, row_id)&#xa;input_hash TEXT&#xa;decision TEXT&#xa;reason TEXT&#xa;evidence JSONB&#xa;RLS — append-only" style="shape=note;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="980" y="490" width="280" height="160" as="geometry" />
        </mxCell>

        <mxCell id="305" value="snapshots (in DB — pointer + metadata)&#xa;&#xa;PK: id&#xa;tenant_id&#xa;parent_snapshot_id → snapshots&#xa;hash TEXT (sha256 of canonical JSON)&#xa;created_at&#xa;created_by USER_ID&#xa;provenance TEXT (onboarding, discovery_proposal, manual_edit, rollback)&#xa;object_store_key TEXT (ref to immutable blob)&#xa;RLS" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1280" y="490" width="280" height="160" as="geometry" />
        </mxCell>

        <mxCell id="306" value="integration_tokens (encrypted)&#xa;&#xa;PK: id&#xa;tenant_id&#xa;integration TEXT (gmail, twilio, stripe, ...)&#xa;encrypted_token BYTEA&#xa;scopes JSONB&#xa;last_rotated_at&#xa;RLS — never in snapshots" style="shape=note;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1580" y="490" width="280" height="160" as="geometry" />
        </mxCell>

        <mxCell id="307" value="idempotency_keys (inbox-pattern)&#xa;&#xa;PK: id&#xa;tenant_id&#xa;source TEXT (gmail, twilio, ...)&#xa;source_event_id TEXT&#xa;UNIQUE (tenant_id, source, source_event_id)&#xa;received_at&#xa;workflow_run_id&#xa;RLS — TTL 72h, then prune" style="shape=note;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1880" y="490" width="280" height="160" as="geometry" />
        </mxCell>

        <!-- =================== LOWER-CORE (per vertical, bottom) =================== -->

        <mxCell id="400" value="LOWER-CORE (per-vertical subclasses, defined in saved-state, materialized as per-tenant tables)" style="swimlane;startSize=30;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="700" width="2120" height="240" as="geometry" />
        </mxCell>

        <mxCell id="401" value="real_estate_listings&#xa;&#xa;PK: id&#xa;tenant_id&#xa;address, list_price_cents, status&#xa;primary_party_id → parties&#xa;attrs JSONB&#xa;RLS" style="shape=note;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="750" width="240" height="120" as="geometry" />
        </mxCell>

        <mxCell id="402" value="real_estate_disclosures&#xa;&#xa;PK: id&#xa;tenant_id&#xa;listing_id → real_estate_listings&#xa;kind TEXT (seller_disclosure, lead_paint)&#xa;expires_at, sent_at, signed_at&#xa;attrs JSONB&#xa;RLS" style="shape=note;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="340" y="750" width="240" height="120" as="geometry" />
        </mxCell>

        <mxCell id="403" value="clinic_appointments&#xa;&#xa;PK: id&#xa;tenant_id&#xa;patient_id → parties (subtype Patient)&#xa;provider_id → parties (Provider)&#xa;scheduled_at, status&#xa;attrs JSONB (reason, notes)&#xa;RLS" style="shape=note;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="600" y="750" width="240" height="120" as="geometry" />
        </mxCell>

        <mxCell id="404" value="clinic_claims&#xa;&#xa;PK: id&#xa;tenant_id&#xa;appointment_id → clinic_appointments&#xa;carrier_id → parties (InsuranceCarrier)&#xa;amount_cents, paid_cents, status&#xa;attrs JSONB (CPT codes, dx)&#xa;RLS" style="shape=note;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="860" y="750" width="240" height="120" as="geometry" />
        </mxCell>

        <mxCell id="405" value="clinic_consent_records&#xa;&#xa;PK: id&#xa;tenant_id&#xa;patient_id → parties (Patient)&#xa;kind TEXT (HIPAA, treatment, telehealth)&#xa;signed_at, expires_at&#xa;evidence_doc_id → object_store&#xa;RLS" style="shape=note;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1120" y="750" width="240" height="120" as="geometry" />
        </mxCell>

        <mxCell id="406" value="sales_opportunities&#xa;&#xa;PK: id&#xa;tenant_id&#xa;account_id → parties (Account)&#xa;stage TEXT (lead, qualified, proposal, won, lost)&#xa;amount_cents, expected_close_at&#xa;attrs JSONB&#xa;RLS" style="shape=note;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1380" y="750" width="240" height="120" as="geometry" />
        </mxCell>

        <mxCell id="407" value="… and so on, one per vertical.&#xa;&#xa;Every table:&#xa;• tenant_id (RLS)&#xa;• JSONB attrs (open schema)&#xa;• refs to upper-core entities (parties, transactions, obligations)&#xa;• materialised from saved-state.ontology.lower_core on first event" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9673a6;dashed=1;dashPattern=6 4;align=left;verticalAlign=top;spacingLeft=8;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="1640" y="750" width="500" height="120" as="geometry" />
        </mxCell>

        <!-- =================== LEGEND =================== -->

        <mxCell id="500" value="Legend" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;verticalAlign=top;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="970" width="2120" height="200" as="geometry" />
        </mxCell>

        <mxCell id="501" value="RLS &amp; Multi-tenancy" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="500">
          <mxGeometry x="20" y="30" width="300" height="20" as="geometry" />
        </mxCell>
        <mxCell id="502" value="• Shared schema, RLS-enforced isolation. One Postgres logical cluster serves all tenants.&#xa;• Per-request: SET app.current_tenant = '&lt;uuid&gt;' on the connection, then RLS policy filters every query automatically.&#xa;• Application role is non-superuser; superuser bypasses RLS, so we never use it from app code.&#xa;• Migrations use a separate owner role with RLS disabled; app role is forced through RLS.&#xa;• Cross-tenant test: connect as app_user, set tenant A, try to SELECT tenant B rows → must return zero." style="text;html=1;align=left;verticalAlign=top;" vertex="1" parent="500">
          <mxGeometry x="20" y="50" width="700" height="100" as="geometry" />
        </mxCell>

        <mxCell id="503" value="Snapshot + Object Store" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="500">
          <mxGeometry x="760" y="30" width="300" height="20" as="geometry" />
        </mxCell>
        <mxCell id="504" value="• Snapshots are immutable JSON blobs in object store (S3/GCS), per-tenant prefix.&#xa;• snapshots table in DB holds metadata + pointer only (object_store_key).&#xa;• Hash = sha256 of canonical JSON, computed on write, verified on read.&#xa;• Rollback = load parent snapshot; in-flight events replay from their Temporal checkpoint.&#xa;• No UPDATE or DELETE on snapshots table; only INSERT (append-only, like git).&#xa;• DB snapshots (for in-flight rollback) are co-stored with the snapshot blob." style="text;html=1;align=left;verticalAlign=top;" vertex="1" parent="500">
          <mxGeometry x="760" y="50" width="700" height="100" as="geometry" />
        </mxCell>

        <mxCell id="505" value="Idempotency" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="500">
          <mxGeometry x="1500" y="30" width="300" height="20" as="geometry" />
        </mxCell>
        <mxCell id="506" value="• Inbox pattern: idempotency_keys (source, source_event_id) UNIQUE per tenant — webhook replays deduped at ingest.&#xa;• Outbox four-tuple key (agent_run_id, step_id, tool_name, business_scope) — every dispatched action is at-most-once per intent.&#xa;• Compensating actions are also idempotent (same key works for forward and reverse).&#xa;• Inbox TTL = 72h (matches typical webhook retry windows)." style="text;html=1;align=left;verticalAlign=top;" vertex="1" parent="500">
          <mxGeometry x="1500" y="50" width="620" height="100" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
