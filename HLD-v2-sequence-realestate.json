{
  "title": "Real Estate Walkthrough — Logging a Lead Call",
  "participants": [
    {"id": "agent", "label": "RE Agent\n(Owner)", "actor": true},
    {"id": "console", "label": "Web Console"},
    {"id": "api", "label": "API Gateway"},
    {"id": "ingest", "label": "Event Ingest"},
    {"id": "worker", "label": "Runtime Worker\n(Temporal)"},
    {"id": "comp", "label": "Compliance\nEngine"},
    {"id": "drafter", "label": "Action Drafter\n(LLM)"},
    {"id": "hitl", "label": "HITL Queue"},
    {"id": "outbox", "label": "Outbox + Saga"},
    {"id": "db", "label": "Postgres\n(RLS)"},
    {"id": "connectors", "label": "Adapters\n(Gmail/CRM/...)"},
    {"id": "lead", "label": "Lead\n(Customer)"}
  ],
  "messages": [
    {"from": "agent", "to": "console", "label": "Log call with lead Jane Doe (5 min, discussed 123 Main St)"},
    {"from": "console", "to": "api", "label": "POST /events (raw call notes + audio transcript)"},
    {"from": "api", "to": "ingest", "label": "enqueue with idempotency key"},
    {"from": "ingest", "to": "db", "label": "INSERT event (tenant, source_event_id) ON CONFLICT skip", "activate": true},
    {"from": "ingest", "to": "worker", "label": "start Temporal workflow (run_id)"},
    {"from": "worker", "to": "worker", "label": "stage 2: Validity Gate (LLM judge + rule prefilter)", "activate": true},
    {"from": "worker", "to": "drafter", "label": "judge: is this a real engagement?", "activate": true},
    {"from": "drafter", "to": "worker", "label": "pass (real call transcript, valid contact)"},
    {"from": "worker", "to": "drafter", "label": "stage 3: Ontology Conversion", "activate": true},
    {"from": "drafter", "to": "worker", "label": "Party(Lead=Jane Doe) + Engagement(Call) + Note(attrs)"},

    {"from": "worker", "to": "db", "label": "stage 4: Context Extraction (read prior Engagements, related listings)", "activate": true},
    {"from": "db", "to": "worker", "label": "Jane Doe has 3 prior calls, viewed 2 listings, no active Agreement"},
    {"from": "worker", "to": "drafter", "label": "stage 5: Function Classification", "activate": true},
    {"from": "drafter", "to": "worker", "label": "→ sales (lead with property interest, no obligation yet)"},
    {"from": "worker", "to": "comp", "label": "stage 6: Compliance & Safety (RE disclosure, PII)", "activate": true},
    {"from": "comp", "to": "worker", "label": "pass (no PII to redact, no financial threshold)"},
    {"from": "worker", "to": "drafter", "label": "stage 7: Action Drafting (3 actions)", "activate": true},
    {"from": "drafter", "to": "worker", "label": "drafts: [SetObligation(follow-up call +3d), SendEmail(thank you, references 123 Main St), LogTransaction(call_log)]"},
    {"from": "worker", "to": "drafter", "label": "classify each: [auto, requires_approval, auto]", "deactivate": true},
    {"from": "worker", "to": "hitl", "label": "stage 8: enqueue SendEmail for approval", "activate": true},
    {"from": "worker", "to": "db", "label": "INSERT approval row (event_id, action, evidence)", "activate": true},
    {"from": "db", "to": "worker", "label": "ok"},
    {"from": "worker", "to": "console", "label": "10b: SSE — 'draft ready for review'"},
    {"from": "console", "to": "agent", "label": "show approval queue (drafted email + evidence)"},
    {"from": "agent", "to": "console", "label": "approve (with minor edit to subject line)"},
    {"from": "console", "to": "hitl", "label": "PATCH /approvals/{id} → approved+edited"},
    {"from": "hitl", "to": "worker", "label": "resume workflow (signal: approved)", "deactivate": true},
    {"from": "worker", "to": "outbox", "label": "stage 9: write outbox row + state changes in same tx", "activate": true},
    {"from": "outbox", "to": "db", "label": "INSERT outbox (four-tuple key, payload)", "activate": true},
    {"from": "outbox", "to": "db", "label": "INSERT party, engagement, obligation, event (all 4 actions)", "activate": true},
    {"from": "db", "to": "outbox", "label": "COMMIT (atomic state + intent)"},
    {"from": "outbox", "to": "connectors", "label": "drainer: dispatch 3 actions (idempotent)", "activate": true},
    {"from": "connectors", "to": "lead", "label": "send thank-you email (Gmail API)"},
    {"from": "lead", "to": "connectors", "label": "200 OK"},
    {"from": "connectors", "to": "db", "label": "UPDATE outbox SET status=sent; audit row written", "deactivate": true},
    {"from": "outbox", "to": "worker", "label": "workflow complete", "deactivate": true},
    {"from": "worker", "to": "db", "label": "stage 10a: append final Event row (XES-extended)", "deactivate": true},
    {"from": "worker", "to": "console", "label": "10b: SSE — 'event complete' (with summary)"},
    {"from": "console", "to": "agent", "label": "show 'Logged call with Jane Doe. Follow-up set for Thu. Email sent.'"},
    {"note": "If the agent had rejected the draft, the workflow would route to a 'promote-to-policy' prompt and the outbox row would be discarded (compensation = no-op since no external action ran).", "over": "worker"}
  ]
}
